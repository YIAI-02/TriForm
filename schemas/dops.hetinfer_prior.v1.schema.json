{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YIAI-02/DOPS/schemas/dops.hetinfer_prior.v1.schema.json",
  "title": "DOPS Het-Infer Static Prior Contract v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "graph_id",
    "workload_id",
    "time_unit",
    "devices",
    "operators",
    "inputs",
    "collective_contexts",
    "legal_movement_routes",
    "expert_placement",
    "t_service",
    "t_move"
  ],
  "properties": {
    "schema": {"const": "dops.hetinfer_prior.v1"},
    "schema_version": {"const": 1},
    "graph_id": {"$ref": "#/$defs/identifier"},
    "workload_id": {"$ref": "#/$defs/identifier"},
    "time_unit": {"const": "seconds"},
    "devices": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/device"}
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operator"}
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "collective_contexts": {
      "type": "array",
      "items": {"$ref": "#/$defs/collectiveContext"}
    },
    "legal_movement_routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/movementRoute"}
    },
    "expert_placement": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/placement"}
    },
    "t_service": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/serviceTime"}
    },
    "t_move": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/movementTime"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "device": {
      "type": "object",
      "required": ["device_id"],
      "properties": {"device_id": {"$ref": "#/$defs/identifier"}},
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "required": ["op_id", "dependencies", "legal_devices"],
      "properties": {
        "op_id": {"$ref": "#/$defs/identifier"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "legal_devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "consumer_op_id",
        "producer_op_id",
        "tensor_id",
        "semantics",
        "bytes",
        "source_residencies",
        "destination_devices"
      ],
      "properties": {
        "consumer_op_id": {"$ref": "#/$defs/identifier"},
        "producer_op_id": {
          "anyOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "tensor_id": {"$ref": "#/$defs/identifier"},
        "semantics": {
          "enum": ["data", "barrier", "collective_staging"]
        },
        "bytes": {"type": "integer", "minimum": 0},
        "source_residencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceResidency"}
        },
        "destination_devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"semantics": {"const": "data"}}},
          "then": {
            "properties": {
              "source_residencies": {"minItems": 1},
              "destination_devices": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"semantics": {"const": "barrier"}}},
          "then": {
            "properties": {
              "producer_op_id": {"$ref": "#/$defs/identifier"},
              "bytes": {"const": 0},
              "source_residencies": {"maxItems": 0},
              "destination_devices": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"semantics": {"const": "collective_staging"}}
          },
          "then": {
            "properties": {
              "producer_op_id": {"$ref": "#/$defs/identifier"},
              "source_residencies": {"minItems": 1},
              "destination_devices": {"minItems": 1, "maxItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"producer_op_id": {"type": "null"}}},
          "then": {"properties": {"semantics": {"const": "data"}}}
        }
      ],
      "additionalProperties": false
    },
    "sourceResidency": {
      "type": "object",
      "required": ["device_id", "layout"],
      "properties": {
        "device_id": {"$ref": "#/$defs/identifier"},
        "layout": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "collectiveContext": {
      "type": "object",
      "required": [
        "op_id",
        "primitive",
        "topology",
        "canonical_device_id",
        "participant_device_ids",
        "output_device_ids",
        "resource_device_ids",
        "tensor_bytes",
        "internal_transport"
      ],
      "properties": {
        "op_id": {"$ref": "#/$defs/identifier"},
        "primitive": {"$ref": "#/$defs/identifier"},
        "topology": {"$ref": "#/$defs/identifier"},
        "canonical_device_id": {"$ref": "#/$defs/identifier"},
        "participant_device_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "output_device_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "resource_device_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "tensor_bytes": {"type": "integer", "minimum": 0},
        "internal_transport": {"const": "included_in_t_service"}
      },
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["op_id", "device_id"],
      "properties": {
        "op_id": {"$ref": "#/$defs/identifier"},
        "device_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "serviceTime": {
      "type": "object",
      "required": ["op_id", "device_id", "duration_s"],
      "properties": {
        "op_id": {"$ref": "#/$defs/identifier"},
        "device_id": {"$ref": "#/$defs/identifier"},
        "duration_s": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "movementRoute": {
      "type": "object",
      "required": [
        "tensor_id",
        "source_device_id",
        "destination_device_id",
        "bytes",
        "layout"
      ],
      "properties": {
        "tensor_id": {"$ref": "#/$defs/identifier"},
        "source_device_id": {"$ref": "#/$defs/identifier"},
        "destination_device_id": {"$ref": "#/$defs/identifier"},
        "bytes": {"type": "integer", "minimum": 0},
        "layout": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "movementTime": {
      "type": "object",
      "required": [
        "tensor_id",
        "source_device_id",
        "destination_device_id",
        "bytes",
        "layout",
        "duration_s"
      ],
      "properties": {
        "tensor_id": {"$ref": "#/$defs/identifier"},
        "source_device_id": {"$ref": "#/$defs/identifier"},
        "destination_device_id": {"$ref": "#/$defs/identifier"},
        "bytes": {"type": "integer", "minimum": 0},
        "layout": {"$ref": "#/$defs/identifier"},
        "duration_s": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
