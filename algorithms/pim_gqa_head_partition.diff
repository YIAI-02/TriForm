+# NOTE:
+# The scheduler/device model uses DeviceSpec.type == "pim".
+# Historically we used "pima"/"pimd" to distinguish PIM sub-types.
+#
+# If an operator allow-map lacks a "pim" key, the scheduler's
+# `allowed.get(dev_type, True)` fallback would treat it as allowed on PIM,
+# which is *wrong*.
+#
+# We therefore normalize allow-maps here by deriving "pim" from
+# ("pima" OR "pimd") when present.
+for _op, _m in list(OPERATOR_DEVICE_ALLOWED.items()):
+    if not isinstance(_m, dict):
+        continue
+    if "pim" not in _m and ("pima" in _m or "pimd" in _m):
+        _m["pim"] = bool(_m.get("pima", False) or _m.get("pimd", False))
+
 
