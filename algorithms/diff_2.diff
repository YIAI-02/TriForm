+def _split_even(total: int, parts: int) -> List[int]:
+    """Split `total` into `parts` nearly-even non-negative integers."""
+    total = int(total)
+    parts = max(1, int(parts))
+    base = total // parts
+    rem = total % parts
+    out = []
+    for i in range(parts):
+        out.append(base + (1 if i < rem else 0))
+    return out
+
+
+def _reduce_sum_add_tree(g: TaskGraph, inputs: List[str], *, prefix: str, attrs: Dict) -> str:
+    """Create a binary Add tree to reduce `inputs` (each produces a dim-vector) into one output."""
+    if not inputs:
+        raise ValueError("reduce_sum got empty inputs")
+    if len(inputs) == 1:
+        return inputs[0]
+    level = 0
+    cur = list(inputs)
+    while len(cur) > 1:
+        nxt: List[str] = []
+        for i in range(0, len(cur), 2):
+            if i + 1 >= len(cur):
+                nxt.append(cur[i])
+                continue
+            nid = f"{prefix}_L{level}_N{i//2}"
+            g.add_node(TaskNode(nid, "Add", flops=0.0, attrs=dict(attrs), allowed=get_op_allowed("Add")))
+            g.add_edge(cur[i], nid)
+            g.add_edge(cur[i + 1], nid)
+            nxt.append(nid)
+        cur = nxt
+        level += 1
+    return cur[0]
+
