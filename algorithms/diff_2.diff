+def _normalize_parallel_dim(shape: ModelShape) -> str:
+    """Normalize user-facing parallelization switch.
+
+    Expected values:
+      - "layer"    (default)
+      - "head_num" (split attention/FFN into head-like shards)
+    """
+    v = str(getattr(shape, "parallel_dim", "layer") or "layer").lower()
