+    def _pick_best_allowed_device(self, g: TaskGraph, nid: str, phase: str) -> DeviceSpec:
+        """Pick the device that yields the earliest finish time (EFT) among allowed devices.
+
+        This is still "naive" in the sense that it schedules nodes in topo order and
+        does not compute HEFT priorities, but it *does* load-balance across multiple
+        PIMs/NPUs by choosing the currently best device.
+        """
+        node = g.nodes[nid]
+        candidates = [d for d in self.cluster.devices.values() if self._node_allowed_on(node, d)]
+        if not candidates:
+            raise RuntimeError(f"No available device for node {nid}")
+
+        best_dev: Optional[DeviceSpec] = None
+        best_finish: float = float('inf')
+        # Evaluate EFT without mutating state.
+        for d in candidates:
+            try:
+                _, fin = self._earliest_finish_on_device(g, nid, d, self.label, phase, commit=False)
+            except Exception:
+                continue
+            if fin < best_finish:
+                best_finish = float(fin)
+                best_dev = d
+
+        if best_dev is None:
+            # Fallback: deterministic priority (npu -> pim -> cpu)
+            for dev_type in ('npu', 'pim', 'cpu'):
+                devs = [d for d in self.cluster.devices_by_type(dev_type) if self._node_allowed_on(node, d)]
+                if devs:
+                    return devs[0]
+            raise RuntimeError(f"No available device for node {nid}")
+        return best_dev
