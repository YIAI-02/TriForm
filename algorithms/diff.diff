 def get_op_allowed(op_name: str) -> Dict[str, bool]:
     key = str(op_name).strip().upper()
     return OPERATOR_DEVICE_ALLOWED.get(key,{}).copy()
+
+def _split_even(total: int, parts: int) -> List[int]:
+    """Evenly split `total` into `parts` non-negative integers.
+
+    Example: total=10, parts=3 -> [4,3,3]
+    """
+    parts = max(1, int(parts or 1))
+    total = max(0, int(total or 0))
+    base = total // parts
+    rem = total % parts
+    return [int(base + (1 if i < rem else 0)) for i in range(parts)]
+
+def _add_reduce_add_chain(
+    g: TaskGraph,
+    prefix: str,
+    inputs: List[str],
+    attrs: Dict,
+    allowed_add: Dict[str, bool],
+) -> str:
+    """Create an Add-chain reduction: (((in0+in1)+in2)+...). Return final node id."""
+    if not inputs:
+        raise ValueError("reduce_add_chain requires at least one input")
+    if len(inputs) == 1:
+        return inputs[0]
+    cur = inputs[0]
+    for i, nxt in enumerate(inputs[1:], start=1):
+        nid = f"{prefix}_Reduce{i}"
+        g.add_node(TaskNode(nid, "Add", flops=0.0, attrs=dict(attrs), allowed=allowed_add))
+        g.add_edge(cur, nid)
+        g.add_edge(nxt, nid)
+        cur = nid
+    return cur
@@
 def add_llama_block(g: TaskGraph, l: int, shape: ModelShape, dtype_bytes: int):
@@
     g.add_edge(nid_ACT, nid_W2); g.add_edge(nid_W2, nid_Add2); g.add_edge(nid_Add1, nid_Add2)
+
+def add_llama_block_head_parallel(
+    g: TaskGraph,
+    l: int,
+    shape: ModelShape,
+    dtype_bytes: int,
+    tp_degree: int,
+):
+    """LLaMA block with head-group parallelism (tensor-parallel style).
+
+    - Q/K/V/QK/Softmax/SV/O + K_write/V_write are sharded by head_group
+    - O and FFN_W2 are reduced via Add-chain (row-parallel style)
+    - head_group assignment uses kv_head % tp_degree (aligns with memory planner)
+    """
+    try:
+        tp_degree = int(tp_degree or 1)
+    except Exception:
+        tp_degree = 1
+    if tp_degree <= 1 or int(getattr(shape, "n_kv_heads", 0) or 0) <= 0 or int(getattr(shape, "n_heads", 0) or 0) <= 0:
+        return add_llama_block(g, l, shape, dtype_bytes)
+
+    b = shape.batch
+    dim, ffn = shape.dim, shape.ffn_dim
+    qh_total, kvh_total, hd = shape.n_heads, shape.n_kv_heads, shape.head_dim
+    group_cnt = max(1, min(int(tp_degree), int(kvh_total)))
+
+    kv_heads_for_group: Dict[int, List[int]] = {gid: [] for gid in range(group_cnt)}
+    for h in range(int(kvh_total)):
+        kv_heads_for_group[int(h % group_cnt)].append(int(h))
+
+    base = int(qh_total) // int(kvh_total)
+    rem = int(qh_total) % int(kvh_total)
+    qh_per_kv = [int(base + (1 if i < rem else 0)) for i in range(int(kvh_total))]
+
+    q_heads_per_group: Dict[int, int] = {}
+    kv_heads_per_group: Dict[int, int] = {}
+    for gid in range(group_cnt):
+        heads = kv_heads_for_group.get(gid, [])
+        kvh_g = int(len(heads))
+        qh_g = int(sum(qh_per_kv[h] for h in heads if 0 <= h < len(qh_per_kv)))
+        kv_heads_per_group[gid] = kvh_g
+        q_heads_per_group[gid] = qh_g
+
+    base_attr_all = {
+        "layer": l,
+        "q_heads": int(qh_total),
+        "kv_heads": int(kvh_total),
+        "head_dim": int(hd),
+        "dim": int(dim),
+        "ffn_dim": int(ffn),
+        "q_dim": int(qh_total * hd),
+        "kv_dim": int(kvh_total * hd),
+        "o_dim": int(qh_total * hd),
+        "batch": int(b),
+    }
+    allowed_LN = get_op_allowed("LN")
+    allowed_Add = get_op_allowed("Add")
+
+    nid_LN1 = f"L{l}_LN1"
+    g.add_node(TaskNode(nid_LN1, "LN", flops=0.0, attrs=dict(base_attr_all), allowed=allowed_LN))
+    if l > 0:
+        for gid in range(group_cnt):
+            prev_kw = f"L{l-1}_K_write_H{gid}"
+            prev_vw = f"L{l-1}_V_write_H{gid}"
+            if prev_kw in g.nodes:
+                g.add_edge(prev_kw, nid_LN1)
+            if prev_vw in g.nodes:
+                g.add_edge(prev_vw, nid_LN1)
+
+    x_in = f"L{l-1}_Add2" if l > 0 else None
+    if x_in:
+        nid_X = f"L{l}_X"
+        g.add_node(TaskNode(nid_X, "Identity", flops=0.0, attrs=dict(base_attr_all), allowed=get_op_allowed("Identity")))
+        g.add_edge(x_in, nid_X)
+        g.add_edge(nid_X, nid_LN1)
+
+    o_parts: List[str] = []
+    for gid in range(group_cnt):
+        qh_g = int(q_heads_per_group.get(gid, 0))
+        kvh_g = int(kv_heads_per_group.get(gid, 0))
+        if qh_g <= 0 or kvh_g <= 0:
+            continue
+        q_dim_g = int(qh_g * hd)
+        kv_dim_g = int(kvh_g * hd)
+        base_attr = {
+            **base_attr_all,
+            "head_group": int(gid),
+            "q_heads": int(qh_g),
+            "kv_heads": int(kvh_g),
+            "q_dim": int(q_dim_g),
+            "kv_dim": int(kv_dim_g),
+            "o_dim": int(q_dim_g),
+        }
+
+        nid_Q = f"L{l}_Q_H{gid}"
+        nid_K = f"L{l}_K_H{gid}"
+        nid_V = f"L{l}_V_H{gid}"
+        g.add_node(TaskNode(nid_Q, "Q", flops=0.0, weight_id=f"L{l}_WQ_H{gid}", weight_size=int(dim * q_dim_g * dtype_bytes), attrs=dict(base_attr), allowed=get_op_allowed("Q")))
+        g.add_node(TaskNode(nid_K, "K", flops=0.0, weight_id=f"L{l}_WK_H{gid}", weight_size=int(dim * kv_dim_g * dtype_bytes), attrs=dict(base_attr), allowed=get_op_allowed("K")))
+        g.add_node(TaskNode(nid_V, "V", flops=0.0, weight_id=f"L{l}_WV_H{gid}", weight_size=int(dim * kv_dim_g * dtype_bytes), attrs=dict(base_attr), allowed=get_op_allowed("V")))
+
+        nid_QK = f"L{l}_QK_H{gid}"
+        nid_SO = f"L{l}_Softmax_H{gid}"
+        nid_SV = f"L{l}_SV_H{gid}"
+        g.add_node(TaskNode(nid_QK, "QK", flops=0.0, attrs=dict(base_attr), allowed=get_op_allowed("QK")))
+        g.add_node(TaskNode(nid_SO, "Softmax", flops=0.0, attrs=dict(base_attr), allowed=get_op_allowed("Softmax")))
+        g.add_node(TaskNode(nid_SV, "SV", flops=0.0, attrs=dict(base_attr), allowed=get_op_allowed("SV")))
+
+        nid_O = f"L{l}_O_H{gid}"
+        g.add_node(TaskNode(nid_O, "O", flops=0.0, weight_id=f"L{l}_WO_H{gid}", weight_size=int(q_dim_g * dim * dtype_bytes), attrs=dict(base_attr), allowed=get_op_allowed("O")))
+        o_parts.append(nid_O)
+
+        nid_KW = f"L{l}_K_write_H{gid}"
+        nid_VW = f"L{l}_V_write_H{gid}"
+        g.add_node(TaskNode(nid_KW, "K_write", attrs=dict(base_attr), allowed=get_op_allowed("K_write")))
+        g.add_node(TaskNode(nid_VW, "V_write", attrs=dict(base_attr), allowed=get_op_allowed("V_write")))
+
+        g.add_edge(nid_LN1, nid_Q)
+        g.add_edge(nid_LN1, nid_K)
+        g.add_edge(nid_LN1, nid_V)
+        g.add_edge(nid_Q, nid_QK)
+        g.add_edge(nid_K, nid_QK)
+        g.add_edge(nid_QK, nid_SO)
+        g.add_edge(nid_SO, nid_SV)
+        g.add_edge(nid_V, nid_SV)
+        g.add_edge(nid_SV, nid_O)
+        g.add_edge(nid_K, nid_KW)
+        g.add_edge(nid_V, nid_VW)
+
+    if not o_parts:
+        return add_llama_block(g, l, shape, dtype_bytes)
+
+    attn_out = _add_reduce_add_chain(g, prefix=f"L{l}_O", inputs=o_parts, attrs=base_attr_all, allowed_add=allowed_Add)
+
+    nid_Add1 = f"L{l}_Add1"
+    g.add_node(TaskNode(nid_Add1, "Add", flops=0.0, attrs=dict(base_attr_all), allowed=allowed_Add))
+    g.add_edge(attn_out, nid_Add1)
+    if x_in:
+        g.add_edge(x_in, nid_Add1)
+
+    nid_LN2 = f"L{l}_LN2"
+    g.add_node(TaskNode(nid_LN2, "LN", flops=0.0, attrs=dict(base_attr_all), allowed=allowed_LN))
+    g.add_edge(nid_Add1, nid_LN2)
+
+    ffn_splits = _split_even(int(ffn), int(group_cnt))
+    w2_parts: List[str] = []
+    for gid in range(group_cnt):
+        ffn_g = int(ffn_splits[gid]) if gid < len(ffn_splits) else 0
+        if ffn_g <= 0:
+            continue
+        attr_g = {**base_attr_all, "head_group": int(gid), "ffn_dim": int(ffn_g)}
+        nid_W1 = f"L{l}_FFN_W1_H{gid}"
+        nid_W3 = f"L{l}_FFN_W3_H{gid}"
