+def _normalize_mini_batch_parts(cfg: Optional[Dict[str, Any]], total_batch: int) -> int:
+    """Return the effective number of mini-batch partitions for prefill."""
+    if total_batch <= 1:
+        return 1
+
+    raw = None
+    for key in ("mini_batch_parts", "micro_batch_parts"):
+        if key in (cfg or {}):
+            raw = (cfg or {}).get(key)
+            break
+
+    try:
+        parts = int(raw or 1)
+    except Exception:
+        parts = 1
+
+    if parts <= 1:
+        return 1
+    return max(1, min(int(total_batch), int(parts)))
+
+
+def _balanced_mini_batch_sizes(total_batch: int, parts: int) -> List[int]:
+    total = max(1, int(total_batch or 1))
+    eff_parts = max(1, min(int(parts or 1), total))
+    base = total // eff_parts
+    rem = total % eff_parts
+    return [int(base + (1 if i < rem else 0)) for i in range(eff_parts)]
+
+
+def expand_graph_for_mini_batch(g: TaskGraph, *, total_batch: int, parts: int) -> TaskGraph:
+    """Clone the whole DAG per mini-batch so the scheduler can overlap them."""
+    splits = _balanced_mini_batch_sizes(int(total_batch), int(parts))
+    if len(splits) <= 1:
+        return g
+
+    out = TaskGraph()
+    try:
+        topo = list(g.topological())
+    except Exception:
+        topo = list(g.nodes.keys())
+
+    for mb_idx, mb_size in enumerate(splits):
+        prefix = f"MB{mb_idx}::"
+        for nid in topo:
+            n = g.nodes[nid]
+            attrs = dict(getattr(n, "attrs", {}) or {})
+            attrs["batch_total"] = int(total_batch)
+            attrs["batch"] = int(mb_size)
+            attrs["micro_batch_enabled"] = True
+            attrs["micro_batch_idx"] = int(mb_idx)
+            attrs["micro_batch_count"] = int(len(splits))
+            attrs["micro_batch_size"] = int(mb_size)
+            attrs["base_node_id"] = str(getattr(n, "id", nid))
+
+            out.add_node(
+                TaskNode(
+                    id=f"{prefix}{n.id}",
+                    name=n.name,
+                    flops=n.flops,
+                    bytes_read=n.bytes_read,
+                    bytes_write=n.bytes_write,
+                    weight_id=n.weight_id,
+                    weight_size=n.weight_size,
+                    allowed=dict(n.allowed) if isinstance(n.allowed, dict) else {},
+                    attrs=attrs,
+                )
+            )
+
+        for u in topo:
+            for v in g.successors(u):
+                out.add_edge(f"{prefix}{u}", f"{prefix}{v}")
+
+    setattr(out, "micro_batch_enabled", True)
+    setattr(out, "micro_batch_parts", int(len(splits)))
+    setattr(out, "micro_batch_sizes", tuple(int(x) for x in splits))
+    setattr(out, "logical_batch", int(total_batch))
+    return out
+
+
+def maybe_expand_prefill_graph(g: TaskGraph, cfg: Optional[Dict[str, Any]]) -> TaskGraph:
+    """Expand only the prefill graph into mini-batches when configured."""
+    total_batch = max(1, int((cfg or {}).get("batch", 1) or 1))
+    parts = _normalize_mini_batch_parts(cfg, total_batch)
+
+    if parts <= 1:
+        if isinstance(cfg, dict):
+            cfg["mini_batch_parts_effective"] = 1
+            cfg["mini_batch_sizes_effective"] = [int(total_batch)]
+            cfg["mini_batch_scope"] = "prefill"
+        return g
+
+    if bool(getattr(g, "micro_batch_enabled", False)):
+        if isinstance(cfg, dict):
+            cfg["mini_batch_parts_effective"] = int(getattr(g, "micro_batch_parts", parts))
+            cfg["mini_batch_sizes_effective"] = list(getattr(g, "micro_batch_sizes", (int(total_batch),)))
+            cfg["mini_batch_scope"] = "prefill"
+        return g
+
+    out = expand_graph_for_mini_batch(g, total_batch=int(total_batch), parts=int(parts))
+    if isinstance(cfg, dict):
+        cfg["mini_batch_parts_effective"] = int(getattr(out, "micro_batch_parts", parts))
+        cfg["mini_batch_sizes_effective"] = list(getattr(out, "micro_batch_sizes", (int(total_batch),)))
+        cfg["mini_batch_scope"] = "prefill"
+    return out
+
