    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/algorithms/main.py",
            "args": [
                "evaluate",
                "--config",
                "./examples/evaluate_test_config.json",
                "--debug",
                "--npu_fast_mode"
            ],
            "cwd": "${workspaceFolder}/algorithms",            
        }
    ]
}