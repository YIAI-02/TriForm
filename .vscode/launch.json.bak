    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/verify/schedule_deploy_verify.py",
            "args": [
                "run-pim",
                "--tasks",
                "./verify/out/hefthint_seg.pim_tasks.json",
                "--out",
                "./verify/out/hefthint_seg.pim_results.json",
                "--cent-sim-root",
                "/Users/yangjiaqi/WW/project_1/python/TriForm/submodules/CENT/cent_simulation",
            ],
            "cwd": "${workspaceFolder}",            
        }
    ]
}