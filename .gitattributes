# Keep the source repository complete while producing a compact, portable
# Zenodo source snapshot with `git archive`.
.gitignore export-ignore
.gitattributes export-ignore
.vscode/** export-ignore
**/*.bak export-ignore
**/.DS_Store export-ignore
**/build/** export-ignore
**/out/** export-ignore
**/profile/** export-ignore
**/kernel_meta/** export-ignore
**/*.o export-ignore
**/*.so export-ignore
**/*.out export-ignore
**/*.log export-ignore
job.* export-ignore

# Generated summaries and machine-specific profiling data are not part of the
# Functional-badge workflow.
